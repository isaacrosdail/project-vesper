{
  "name": "project-vesper",
  "version": "0.2.0",
  "type": "module",
  "devDependencies": {
    "@eslint/css": "^1.4.0",
    "@eslint/js": "^9.39.4",
    "@happy-dom/global-registrator": "^20.8.4",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/bun": "^1.3.11",
    "@types/d3": "^7.4.3",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.7.0",
    "happy-dom": "^20.8.4",
    "inquirer": "^14.0.2",
    "json-schema-to-typescript": "^15.0.4",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.7",
    "svelte-check": "^4.7.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.5",
    "vite-bundle-analyzer": "^1.3.9",
    "vite-plugin-full-reload": "^1.2.0"
  },
  "overrides": {
    "immutable": "4.3.9"
  },
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n vite,flask \"vite\" \"npm run -s flask:dev\"",
    "flask:dev": "uv run flask run --debug",
    "build": "vite build",
    "lint": "eslint app/static_src",
    "lint:py": "ruff check .",
    "lint:templates": "uv run djlint app/ --lint",
    "format": "prettier --write app/static_src",
    "format:py": "uv run ruff format .",
    "format:templates": "uv run djlint app/ --reformat",
    "type-check": "tsc --noEmit",
    "type-check:svelte": "svelte-check",
    "type-check:py": "uv run mypy .",
    "check": "npm run lint && npm run lint:py && npm run lint:templates && npm run type-check && npm run type-check:py && npm run type-check:svelte",
    "audit": "npm audit --audit-level=high",
    "prepare": "git config core.hooksPath .githooks",
    "gen-types": "PYTHONPATH=. uv run pydantic2ts --module ./app/api/schemas.py --exclude APISchema --exclude APIReadSchema --output ./app/static_src/js/apiTypes.ts"
  },
  "dependencies": {
    "@tanstack/svelte-hotkeys": "^0.10.0",
    "d3": "^7.9.0",
    "temporal-polyfill": "^1.0.1"
  }
}
